# Copier ce fichier en .env (à la racine du dépôt) et adapter les valeurs.
# .env n'est jamais versionné (voir .gitignore). En CI/production, définir
# ces mêmes clés comme variables d'environnement.

# --- Django ---
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=changez-moi-en-local-et-en-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# En production HTTPS : origines de confiance pour les formulaires POST.
# CSRF_TRUSTED_ORIGINS=https://mon-domaine.tld

# --- Base de données ---
# Par défaut : SQLite (aucune autre variable nécessaire).
# Option 1 (recommandée en prod) : une seule URL. Ex. Neon (gratuit, sans
# expiration) : garder ?sslmode=require, endpoint « -pooler » de préférence.
# DATABASE_URL=postgres://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require
# Option 2 : variables séparées.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=maturite_numerique
# DB_USER=maturite
# DB_PASSWORD=motdepasse
# DB_HOST=localhost
# DB_PORT=5432

# --- E-mail (console en dev ; SMTP en prod) ---
# Sans ces variables : backend console (les e-mails s'affichent dans les logs,
# rien n'est réellement envoyé) — y compris le code de connexion (2e étape du
# login, voir verification_code_view). Pour recevoir vraiment les e-mails,
# renseigner un vrai SMTP, par ex. avec Gmail (gratuit) :
#   1. Activer la validation en 2 étapes sur le compte Google.
#   2. Créer un « mot de passe d'application » : myaccount.google.com/apppasswords
#   3. Utiliser ce mot de passe (pas celui du compte) ci-dessous.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=votre-adresse@gmail.com
# EMAIL_HOST_PASSWORD=mot-de-passe-d-application-16-caracteres
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Maturité Numérique <votre-adresse@gmail.com>
# CONTACT_EMAIL=contact@maturite-numerique.tg

# --- Amorçage du conteneur (entrypoint.sh) ---
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@maturite-numerique.tg
# DJANGO_SUPERUSER_PASSWORD=un-mot-de-passe-fort
# SEED_DEMO=1        # génère le jeu de démo au démarrage (réinitialise les données !)

# --- Production (facultatif) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000   # à activer une fois le domaine confirmé en HTTPS
# WEB_CONCURRENCY=3
