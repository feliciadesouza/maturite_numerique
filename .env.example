# Copier ce fichier en .env (à la racine du dépôt) et adapter les valeurs.
# .env n'est jamais versionné (voir .gitignore). En CI/production, définir
# ces mêmes clés comme variables d'environnement.

# --- Django ---
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=changez-moi-en-local-et-en-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de données ---
# Par défaut : SQLite (aucune autre variable nécessaire).
# Pour PostgreSQL, décommenter et renseigner :
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=maturite_numerique
# DB_USER=maturite
# DB_PASSWORD=motdepasse
# DB_HOST=localhost
# DB_PORT=5432
